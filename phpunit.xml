<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <groups>
        <exclude>
            <group>slow</group>
        </exclude>
    </groups>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>tests/Http</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" is REQUIRED. PHPUnit's <env> silently skips any variable
             already present in the shell environment. The deployment shell exports
             DB_CONNECTION=mysql / DB_DATABASE=cems_my_staging (plus APP_KEY,
             CACHE_DRIVER, QUEUE_CONNECTION, SESSION_DRIVER, REDIS_*), so without
             force the suite runs against the LIVE staging database and
             RefreshDatabase's migrate:fresh drops those tables. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:WlbBhnWV/8WIwLujIHnV4WqVBGA6jVh/6mAt4gt+NN8=" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="RATE_LIMIT_CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="REDIS_CLIENT" value="phpredis" force="true"/>
        <env name="REDIS_HOST" value="127.0.0.1" force="true"/>
        <env name="REDIS_PASSWORD" value="Klzk@9199" force="true"/>
        <env name="BACKUP_NOTIFY_EMAIL" value="backups@example.com" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="ALLOW_DERIVED_ENCRYPTION_SALT" value="false" force="true"/>
        <env name="SECURITY_IP_BLOCKING_ENABLED" value="false" force="true"/>
        <env name="XDEBUG_MODE" value="off" force="true"/>
    </php>
</phpunit>
