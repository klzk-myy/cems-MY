# Deployment target
DEPLOY_HOST=203.0.113.20
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/cems-my
DEPLOY_APP_URL=https://cems-my.example
DEPLOY_BRANCH=main

# SSH private key path (used only for remote deploys)
# DEPLOY_SSH_KEY=/home/user/.ssh/id_rsa_cems_production

# Slack notification webhook (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Threshold tuning (THRESHOLD_*, SLA_*, POSITION_LIMIT_*) goes in the
# application .env on the target server — this file only configures the
# deploy tool itself. See .env.example for the full list. Post-deploy,
# `php artisan thresholds:check-overrides` warns when DB overrides in
# threshold_audits take precedence over env values.
