APP_NAME=CEMS-MY
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# WARNING: Never set APP_DEBUG=true in production. Debug mode exposes stack traces,
# PII, and query logs to users. The QueryLogServiceProvider activates query
# monitoring when app.debug is true, creating a PII leak vector.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cems_my
DB_USERNAME=cems_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Seconds a password confirmation stays valid for sensitive routes
# (exports, user/role management, setup reset). Default: 10800 (3 hours).
AUTH_PASSWORD_TIMEOUT=10800
# Session cookie domain — must match the host you browse to (e.g. local.host).
# SESSION_DOMAIN=local.host
# Sanctum stateful domains — required so session-authed browser requests to
# /api/v1/* (transaction wizard, notification polling) pass auth:sanctum.
# Defaults derive from APP_URL; override if you serve a different host.
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,local.host

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@cems-my.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SQS Queue Configuration
# Required when QUEUE_CONNECTION=sqs. Example: https://sqs.us-east-1.amazonaws.com/123456789012
SQS_PREFIX=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Redis - Local development uses the shared password below, which MUST stay
# in sync with REDIS_PASSWORD in phpunit.xml (tests force it via <env>).
# WARNING: Staging and production MUST configure Redis requirepass and set a
# strong unique REDIS_PASSWORD here. Never deploy with an empty Redis password.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redpass
REDIS_PREFIX=cems_database_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Trusted reverse proxies (comma-separated IPs/CIDR; '*' trusts all).
# Set this to the CIDR/address of your reverse proxy (e.g. nginx) so the
# real client IP is resolved from X-Forwarded-For. Leaving it empty means
# every request appears to come from the proxy IP, collapsing per-IP
# rate limiting and IP blocking behind nginx.
TRUSTED_PROXIES=192.168.0.0/16,127.0.0.1

# Encryption salt for PII field encryption (64-char hex string).
# In production this MUST be set. In local/testing it may be derived from APP_KEY
# if ALLOW_DERIVED_ENCRYPTION_SALT=true, but setting a real salt is recommended.
APP_ENCRYPTION_SALT=
ALLOW_DERIVED_ENCRYPTION_SALT=false

# Cache store for rate limiting and IP blocking (should be shared across workers)
RATE_LIMIT_CACHE_STORE=redis

# Maximum data rows accepted per CSV batch import (runs synchronously in the request)
TRANSACTION_BATCH_MAX_ROWS=5000

# Batch-import upper bounds: reject rows exceeding these before processing
TRANSACTION_IMPORT_MAX_AMOUNT_FOREIGN=1000000
TRANSACTION_IMPORT_MAX_RATE=100

# CORS - Allowed origins for cross-origin requests
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=https://app.local.host

# BNM MSB license number (required for Form LMCA regulatory reports).
# Set to your actual Bank Negara Malaysia license number.
BNM_LICENSE_NUMBER=MSB-0000000

# Company details
COMPANY_NAME="Currency Exchange Management System"
COMPANY_REGISTRATION_NUMBER="000000-T"
REGISTRATION_NUMBER="000000-T"
BNM_CONTACT_NAME=""
BNM_CONTACT_EMAIL=""
BNM_CONTACT_PHONE=""

# CEMS Compliance Thresholds (RM) — values mirror the defaults in
# config/thresholds.php. Note: overrides persisted via
# ThresholdService::set() (threshold_audits table) take precedence over env.

# Approval Thresholds
THRESHOLD_AUTO_APPROVE=10000
THRESHOLD_MANAGER=50000

# CDD Thresholds
THRESHOLD_CDD_SPECIFIC=3000
THRESHOLD_CDD_STANDARD=10000
THRESHOLD_CDD_LARGE=50000

# Risk Scoring Thresholds (MYR amounts, NOT 0-100 scores — see
# THRESHOLD_RISK_SCORE_* in config/thresholds.php for score bands)
THRESHOLD_RISK_HIGH=50000
THRESHOLD_RISK_MEDIUM=30000
THRESHOLD_RISK_LOW=10000

# Alert Triage Thresholds
THRESHOLD_ALERT_CRITICAL=50000
THRESHOLD_ALERT_HIGH=30000
THRESHOLD_ALERT_MEDIUM=10000

# Reporting Thresholds (BNM requirements)
THRESHOLD_STR=50000
THRESHOLD_EDD=50000
# Auto-generate Suspicious Transaction Reports when thresholds are breached
STR_AUTO_GENERATE=true
# Nationalities excluded from foreign-customer location-anomaly monitoring (comma-separated)
DOMESTIC_NATIONALITIES=Malaysian,Malaysia

# Structuring Detection
THRESHOLD_STRUCTURING_SUB=3000
THRESHOLD_STRUCTURING_MIN_TXNS=3
THRESHOLD_STRUCTURING_HOURS=1
THRESHOLD_STRUCTURING_LOOKUP_DAYS=7

# Transaction Duration Thresholds (hours)
THRESHOLD_DURATION_WARNING=24
THRESHOLD_DURATION_CRITICAL=48

# Counter/Till Variance Thresholds
THRESHOLD_VARIANCE_YELLOW=100.00
THRESHOLD_VARIANCE_RED=500.00

# Velocity Monitoring
THRESHOLD_VELOCITY_ALERT=50000
THRESHOLD_VELOCITY_WARNING=45000
THRESHOLD_VELOCITY_WINDOW_DAYS=90
AGGREGATE_LOOKBACK_DAYS=7

# AML Rules
THRESHOLD_AML_AMOUNT=50000
THRESHOLD_AML_AGGREGATE=50000

# Currency Flow Monitoring
THRESHOLD_ROUND_TRIP=5000
THRESHOLD_CURRENCY_FLOW_LOOKBACK_DAYS=7

KYC_GRACE_PERIOD_DAYS=5
RISK_REVIEW_BATCH_SIZE=50
CANCELLATION_WINDOW_HOURS=24
SYSTEM_USER_ID=1

# Risk Score Bands (0-100 customer score — NOT MYR amounts)
THRESHOLD_RISK_SCORE_HIGH=75
THRESHOLD_RISK_SCORE_MEDIUM=50
THRESHOLD_RISK_SCORE_LOW=25
# Days since last risk assessment before a customer is due for rescreening
THRESHOLD_RISK_RESCREENING_DAYS=30

# Structuring Risk Score Tiers (transactions/hour -> score points)
THRESHOLD_STRUCTURING_SCORE_HIGH_COUNT=3
THRESHOLD_STRUCTURING_SCORE_HIGH=25
THRESHOLD_STRUCTURING_SCORE_LOW_COUNT=2
THRESHOLD_STRUCTURING_SCORE_LOW=10
THRESHOLD_STRUCTURING_SCORE_CAP=30

# Unusual-Pattern Monitoring (days lookback, multiplier of trailing avg)
THRESHOLD_UNUSUAL_LOOKBACK_DAYS=90
THRESHOLD_UNUSUAL_MULTIPLIER=2

# Velocity amount-window lookback (hours)
THRESHOLD_VELOCITY_AMOUNT_WINDOW_HOURS=24

# Geographic Risk Weights (score points)
THRESHOLD_GEO_HIGH_COUNTRY_WEIGHT=30
THRESHOLD_GEO_RECENT_TRAVEL_WEIGHT=15

# Compliance SLAs (hours)
SLA_ALERT_CRITICAL=4
SLA_ALERT_HIGH=8
SLA_ALERT_MEDIUM=24
SLA_ALERT_LOW=72
SLA_CASE_CRITICAL=24
SLA_CASE_HIGH=48
SLA_CASE_MEDIUM=120
SLA_CASE_LOW=240

# Position Limits (foreign-currency units per currency)
POSITION_LIMIT_USD=1000000
POSITION_LIMIT_EUR=800000
POSITION_LIMIT_GBP=700000
POSITION_LIMIT_SGD=900000
POSITION_LIMIT_JPY=100000000
POSITION_LIMIT_AUD=750000
POSITION_LIMIT_CHF=700000
POSITION_LIMIT_CAD=700000
POSITION_LIMIT_HKD=6000000

# Performance Monitoring Thresholds
THRESHOLD_RESPONSE_TIME_WARNING=500
THRESHOLD_CACHE_HIT_RATE_WARNING=70
THRESHOLD_QUERY_TIME_WARNING=100
THRESHOLD_JOB_DURATION_WARNING=5000

# Low stock alert — total per-currency position (foreign units) below this trips an alert
THRESHOLD_LOW_STOCK=10000

# POS Configuration
POS_RATE_CACHE_TTL=3600
POS_THERMAL_PRINTER_DEFAULT=
POS_RECEIPT_STORAGE_PATH=

# Security
# Flags below are set explicitly to their config defaults so an empty-string
# env value cannot silently defeat a `true` default (filter_var('') = false).
MFA_ENABLED=true
SMS_ENABLED=false
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SECURITY_IP_BLOCKING_ENABLED=true
SECURITY_FAILED_ATTEMPTS_THRESHOLD=10
SECURITY_IP_BLOCK_DURATION=60
SECURITY_IP_WHITELIST=192.168.1.0/24,127.0.0.1
# Master switch for all throttle middleware. Keep true in production;
# set false only in disposable dev environments.
SECURITY_RATE_LIMITING_ENABLED=true
SECURITY_RATE_LIMIT_MONITORING=true
SECURITY_RATE_ALERT_THRESHOLD=3
# Password length floor in characters and bcrypt byte cap.
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_MAX_BYTES=72
# Forced password rotation interval in days. 0 = never expires.
SECURITY_PASSWORD_EXPIRY_DAYS=0
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=

# Rate Configuration (spreads/deviation are decimal fractions, e.g. 0.02 = 2%)
RATE_CACHE_DURATION=60
RATE_PRECISION=4
RATE_MAX_SPREAD=0.05
RATE_MIN_SPREAD=0.005
RATE_SPREAD=0.02
RATE_MAX_DEVIATION=0.05
RATE_STALENESS_HOURS=8
# Per-role rate-override limits in percentage points (BNM)
RATE_OVERRIDE_LIMIT_TELLER=0.5
RATE_OVERRIDE_LIMIT_MANAGER=2.0

# Scheduled automatic rate refresh from the upstream API (opt-in)
RATE_AUTO_FETCH_ENABLED=false

# Exchange Rate API
EXCHANGE_RATE_API_BASE_URL=
EXCHANGE_RATE_API_KEY=
API_RATES_CURRENCIES=MYR,USD,SGD,MAL,CNY,EUR,GBP,AUD,CAD,JPY

# Notifications
WEBHOOK_NOTIFICATIONS_ENABLED=false
WEBHOOK_NOTIFICATIONS_URL=
WEBHOOK_NOTIFICATIONS_SECRET=
NOTIFICATION_DIGEST_ENABLED=true
NOTIFICATION_DIGEST_FREQUENCY=daily
NOTIFICATION_DIGEST_TIME=09:00
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_CLEANUP_ENABLED=true
AUDIT_RETENTION_DAYS=2555

# Encryption
ENCRYPTION_ITERATIONS=100000

# Backup Webhook Notifications
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_DISCORD_WEBHOOK_URL=

# Backup archive encryption password (spatie/laravel-backup).
# Leave empty to disable archive encryption; set a strong password for
# production so backup archives are AES-256 encrypted at rest.
BACKUP_ARCHIVE_PASSWORD=

# Horizon Notification Email
HORIZON_MAIL_NOTIFICATIONS_TO=

# Backup Notification Email
BACKUP_NOTIFY_EMAIL=ops@example.com

# System Alert Email Recipients (comma-separated)
SYSTEM_ALERT_RECIPIENTS=

# Query Logging
QUERY_LOG_LEVEL=

# Accounting Account Configurations
# Every code below MUST exist in App\Enums\AccountCode.
ACCOUNT_REVENUE_SUMMARY=4201
ACCOUNT_EXPENSE_SUMMARY=4201
ACCOUNT_FOREX_POSITION=4102
# Validate chart-of-account codes exist before posting journal entries
ACCOUNTING_VALIDATE_ACCOUNTS=true
ACCOUNT_RETAINED_EARNINGS=4100
ACCOUNT_REVALUATION_GAIN=5110
ACCOUNT_REVALUATION_LOSS=6100

# Broadcasting (Ably)
ABLY_KEY=

# Sanctions Data Sources
SANCTIONS_MOHA_URL=https://data.opensanctions.org/datasets/latest/my_moha_sanctions/targets.nested.json
SANCTIONS_CONSUMER_ALERT_URL=https://data.opensanctions.org/datasets/latest/my_consumer_alert_list/targets.nested.json
SANCTIONS_INVESTOR_ALERT_URL=https://data.opensanctions.org/datasets/latest/my_investor_alert_list/targets.nested.json
SANCTIONS_SC_AOB_URL=https://data.opensanctions.org/datasets/latest/my_aob_sanctions/targets.nested.json
SANCTIONS_UN_URL=https://data.opensanctions.org/datasets/latest/un_sc_sanctions/targets.nested.json
SANCTIONS_OFAC_URL=https://data.opensanctions.org/datasets/latest/us_ofac_sdn/targets.nested.json
SANCTIONS_HMT_URL=https://data.opensanctions.org/datasets/latest/gb_fcdo_sanctions/targets.nested.json
SANCTIONS_EU_URL=https://data.opensanctions.org/datasets/latest/eu_fsf/targets.nested.json
SANCTIONS_WEBHOOK_TOKEN=
SANCTIONS_ARCHIVE_RETENTION_DAYS=30
SANCTIONS_TEMP_RETENTION_HOURS=24
# Screening match scores (0-100). Outside ThresholdService by design: they are
# fuzzy-match score bands, not currency/time limits.
SANCTIONS_THRESHOLD_FLAG=75
SANCTIONS_THRESHOLD_BLOCK=90

# Fiscal year closing date (default 31 December)
FISCAL_YEAR_END_MONTH=12
FISCAL_YEAR_END_DAY=31
