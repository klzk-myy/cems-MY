APP_NAME=CEMS-MY
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# WARNING: Never set APP_DEBUG=true in production. Debug mode exposes stack traces,
# PII, and query logs to users. The QueryLogServiceProvider activates query
# monitoring when app.debug is true, creating a PII leak vector.
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cems_my
DB_USERNAME=cems_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@cems-my.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SQS Queue Configuration
# Required when QUEUE_CONNECTION=sqs. Example: https://sqs.us-east-1.amazonaws.com/123456789012
SQS_PREFIX=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Redis - Local development runs without authentication.
# WARNING: Staging and production MUST configure Redis requirepass and set a
# strong REDIS_PASSWORD here. Never deploy with an empty Redis password.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=cems_database_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Trusted reverse proxies (comma-separated IPs/CIDR; '*' trusts all).
# Set this to the CIDR/address of your reverse proxy (e.g. nginx) so the
# real client IP is resolved from X-Forwarded-For. Leaving it empty means
# every request appears to come from the proxy IP, collapsing per-IP
# rate limiting and IP blocking behind nginx.
TRUSTED_PROXIES=192.168.0.0/16,127.0.0.1

# Encryption salt for PII field encryption (64-char hex string).
# In production this MUST be set. In local/testing it may be derived from APP_KEY
# if ALLOW_DERIVED_ENCRYPTION_SALT=true, but setting a real salt is recommended.
APP_ENCRYPTION_SALT=
ALLOW_DERIVED_ENCRYPTION_SALT=false

# Cache store for rate limiting and IP blocking (should be shared across workers)
RATE_LIMIT_CACHE_STORE=redis

# Maximum data rows accepted per CSV batch import (runs synchronously in the request)
TRANSACTION_BATCH_MAX_ROWS=5000

# Batch-import upper bounds: reject rows exceeding these before processing
TRANSACTION_IMPORT_MAX_AMOUNT_FOREIGN=1000000
TRANSACTION_IMPORT_MAX_RATE=100

# CORS - Allowed origins for cross-origin requests
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=https://app.local.host

# BNM MSB license number (required for Form LMCA regulatory reports).
# Set to your actual Bank Negara Malaysia license number.
BNM_LICENSE_NUMBER=MSB-0000000

# Company details
COMPANY_NAME="Currency Exchange Management System"
COMPANY_REGISTRATION_NUMBER="000000-T"
REGISTRATION_NUMBER="000000-T"
BNM_CONTACT_NAME=""
BNM_CONTACT_EMAIL=""
BNM_CONTACT_PHONE=""

# CEMS Compliance Thresholds (RM)
THRESHOLD_CDD_STANDARD=1000
THRESHOLD_CDD_SPECIFIC=3000
THRESHOLD_CDD_LARGE=10000
THRESHOLD_STR=3000
THRESHOLD_STR_APPROVAL_REQUIRED=100000
# Auto-generate Suspicious Transaction Reports when thresholds are breached
STR_AUTO_GENERATE=true
# Nationalities excluded from foreign-customer location-anomaly monitoring (comma-separated)
DOMESTIC_NATIONALITIES=Malaysian,Malaysia
THRESHOLD_VELOCITY_WINDOW_DAYS=90
THRESHOLD_VELOCITY_ALERT=50
THRESHOLD_VELOCITY_WARNING=30
AGGREGATE_LOOKBACK_DAYS=30
THRESHOLD_AML_AMOUNT=50000
THRESHOLD_AML_AGGREGATE=100000
THRESHOLD_EDD=100000
RISK_REVIEW_BATCH_SIZE=100
CANCELLATION_WINDOW_HOURS=48
KYC_GRACE_PERIOD_DAYS=7
SYSTEM_USER_ID=1
THRESHOLD_MANAGER=50000
THRESHOLD_AUTO_APPROVE=3000
THRESHOLD_RISK_LOW=30
THRESHOLD_RISK_MEDIUM=50
THRESHOLD_RISK_HIGH=70
THRESHOLD_ALERT_MEDIUM=50
THRESHOLD_ALERT_HIGH=75
THRESHOLD_ALERT_CRITICAL=90
THRESHOLD_VARIANCE_YELLOW=500
THRESHOLD_VARIANCE_RED=1000
THRESHOLD_CURRENCY_FLOW_LOOKBACK_DAYS=7
THRESHOLD_QUERY_TIME_WARNING=100
THRESHOLD_RESPONSE_TIME_WARNING=200
THRESHOLD_CACHE_HIT_RATE_WARNING=80
THRESHOLD_JOB_DURATION_WARNING=300

# Thresholds service config
THRESHOLD_STRUCTURING_HOURS=24
THRESHOLD_STRUCTURING_MIN_TXNS=5
THRESHOLD_ROUND_TRIP=5000
THRESHOLD_DURATION_WARNING=48
THRESHOLD_DURATION_CRITICAL=72
THRESHOLD_STR=3000
THRESHOLD_STRUCTURING_LOOKUP_DAYS=90
THRESHOLD_STRUCTURING_SUB=0.9

# POS Configuration
POS_EOD_VARIANCE_RED=500
POS_EOD_VARIANCE_YELLOW=200
POS_RATE_CACHE_TTL=300
POS_THERMAL_PRINTER_DEFAULT=
POS_RECEIPT_STORAGE_PATH=

# Security
# Flags below are set explicitly to their config defaults so an empty-string
# env value cannot silently defeat a `true` default (filter_var('') = false).
MFA_ENABLED=true
SMS_ENABLED=false
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SECURITY_IP_BLOCKING_ENABLED=true
SECURITY_IP_BLOCK_DURATION=3600
SECURITY_IP_WHITELIST=
SECURITY_RATE_LIMIT_MONITORING=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=

# Rate Configuration
RATE_CACHE_DURATION=86400
RATE_PRECISION=4
RATE_MAX_SPREAD=2
RATE_MIN_SPREAD=0
RATE_SPREAD=1
RATE_MAX_DEVIATION=5
RATE_STALENESS_HOURS=8

# Scheduled automatic rate refresh from the upstream API (opt-in)
RATE_AUTO_FETCH_ENABLED=false

# Exchange Rate API
EXCHANGE_RATE_API_BASE_URL=
EXCHANGE_RATE_API_KEY=
API_RATES_CURRENCIES=MYR,USD,SGD,MAL,CNY,EUR,GBP,AUD,CAD,JPY

# Notifications
WEBHOOK_NOTIFICATIONS_ENABLED=false
WEBHOOK_NOTIFICATIONS_URL=
WEBHOOK_NOTIFICATIONS_SECRET=
NOTIFICATION_DIGEST_ENABLED=true
NOTIFICATION_DIGEST_FREQUENCY=3600
NOTIFICATION_DIGEST_TIME=09:00
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_CLEANUP_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Encryption
ENCRYPTION_ITERATIONS=65536

# Backup Webhook Notifications
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_DISCORD_WEBHOOK_URL=

# Backup archive encryption password (spatie/laravel-backup).
# Leave empty to disable archive encryption; set a strong password for
# production so backup archives are AES-256 encrypted at rest.
BACKUP_ARCHIVE_PASSWORD=

# Horizon Notification Email
HORIZON_MAIL_NOTIFICATIONS_TO=

# Backup Notification Email
BACKUP_NOTIFY_EMAIL=ops@example.com

# System Alert Email Recipients (comma-separated)
SYSTEM_ALERT_RECIPIENTS=

# Query Logging
QUERY_LOG_LEVEL=

# Accounting Account Configurations
# Every code below MUST exist in App\Enums\AccountCode.
ACCOUNT_REVENUE_SUMMARY=4201
ACCOUNT_EXPENSE_SUMMARY=4201
ACCOUNT_FOREX_POSITION=4102
# Validate chart-of-account codes exist before posting journal entries
ACCOUNTING_VALIDATE_ACCOUNTS=true
ACCOUNT_RETAINED_EARNINGS=4100
ACCOUNT_REVALUATION_GAIN=5110
ACCOUNT_REVALUATION_LOSS=6100

# Broadcasting (Ably)
ABLY_KEY=

# Sanctions Data Sources
SANCTIONS_UN_URL=https://www.opensanctions.org/datasets/un_sc_sanctions/targets.nested.json
SANCTIONS_MOHA_URL=https://www.opensanctions.org/datasets/my_moha_sanctions/targets.nested.json
